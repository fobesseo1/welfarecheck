# 이 파일을 복사해 .env.local 로 만들고 값을 채운다. .env.local 은 커밋되지 않는다(.gitignore).

# 공공데이터포털(data.go.kr) 일반 인증키 (Decoding) — 수집 스크립트(tools/facilities)만 쓴다
# 키 하나로 모든 API를 쓰지만, 아래 API마다 '활용신청'을 각각 눌러야 호출된다 (승인 후 반영까지 1~2시간)
#   15059029 국민건강보험공단_장기요양기관 검색 서비스
#   15058856 국민건강보험공단_장기요양기관 시설별 상세조회 서비스
#   15001698 건강보험심사평가원_병원정보서비스 (요양병원 목록·좌표)
#   15001699 건강보험심사평가원_의료기관별상세정보서비스
#   15094093 건강보험심사평가원_병원평가정보서비스 (요양병원 적정성평가)
#   15021138 전국치매센터표준데이터 (선택)
DATA_GO_KR_SERVICE_KEY=

# 네이버 지도 Client ID — 브라우저에 들어가도 되는 값(등록 도메인에서만 작동). 선자산과 같은 값
# 배포 빌드는 GitHub 저장소 Actions Variables 에 같은 이름으로 등록
NEXT_PUBLIC_NAVER_MAP_CLIENT_ID=
# 네이버 Client Secret 은 모심듀오에서 쓰지 않는다 (웹 빌드에 들어가지 않게 막아 둠)

# 도로명주소 좌표제공 API 승인키 (business.juso.go.kr → API 신청 → 좌표제공) — 장기요양기관 좌표 (tools/facilities geo)
# 공단 자료엔 글자 주소가 없고 도로명코드·건물번호만 있어, 이 값을 그대로 받는 이 API를 쓴다
JUSO_COORD_API_KEY=

# 브이월드 키 — 지금은 쓰지 않음 (브이월드는 도로명 '글자'로만 찾을 수 있음). 나중에 보조용
VWORLD_API_KEY=
